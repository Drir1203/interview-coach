# PostgreSQL 数据库连接（Docker 内使用容器名 postgres）
DATABASE_URL="postgresql://interview:change_this_password@postgres:5432/interview_coach?sslmode=disable"

# Auth.js 密钥（生产环境务必修改）
AUTH_SECRET="your-random-secret-at-least-32-chars"

# AI 服务（平台配置，用户无感知）
DEEPSEEK_API_KEY="sk-..."                # AI 复盘首选（DeepSeek）
DASHSCOPE_API_KEY="sk-..."               # AI 复盘备选 + 语音转写（Qwen3-ASR-Flash）
ANTHROPIC_API_KEY="sk-ant-..."           # AI 复盘备选
ANTHROPIC_BASE_URL="https://api.anthropic.com"
AI_MODEL="deepseek-chat"                 # 默认 AI 模型

# 付费墙 v1（Mock 支付）
MOCK_PAY_SECRET="your-mock-pay-secret"   # mock 支付回调验签密钥（X-Mock-Secret 头）
PAYMENT_ADMIN_KEY="your-admin-key"       # 手动开通会员的管理密钥（/api/payment/mock/approve）
# MOCK_AUTO_PAY="true"                   # 仅本地/测试置 true：pricing 页显示「模拟支付成功」按钮；生产勿设

