# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# 密钥文件（绝不提交）
.env
.env.local
ecosystem.config.cjs

# 运行时日志
logs/

# Git Bash 崩溃转储（Windows）
bash.exe.stackdump

# 小程序 npm（DevTools 构建生成，不入库）
/miniprogram/node_modules/
/miniprogram/miniprogram_npm/
/miniprogram/package-lock.json

# 微信开发者工具私有配置（含个人 AppID / 本地勾选）
/miniprogram/project.private.config.json

# PDF 导出调试产物
/.pdf-repro/
