/**app.wxss**/
/* ========== 品牌设计 Token ==========
   与 Web 端 src/app/globals.css 保持一致的柔和靛蓝主题
   未来 Pro 皮肤/付费墙只需替换这里  */
page {
  /* 品牌色 */
  --brand-primary: #6366f1;
  --brand-primary-light: #eef2ff;
  --brand-primary-dark: #4338ca;
  --brand-bg: #f8fafc;
  --brand-card: #ffffff;
  --brand-text: #1e293b;
  --brand-muted: #f1f5f9;
  --brand-muted-text: #64748b;
  --brand-border: #e2e8f0;
  --brand-danger: #ef4444;
  --brand-success: #07c160;
  /* 圆角 / 间距 */
  --brand-radius-lg: 24rpx;
  --brand-radius-md: 16rpx;
  --brand-radius-sm: 12rpx;

  /* Vant 主题映射（--van-* 是 Vant 组件的定制变量） */
  --van-primary-color: #6366f1;
  --van-success-color: #07c160;
  --van-danger-color: #ef4444;
  --van-button-primary-background: #6366f1;
  --van-button-primary-border-color: #6366f1;
  --van-button-radius: 16rpx;
  --van-button-default-height: 88rpx;
  --van-button-default-color: #1e293b;
  --van-field-label-color: #1e293b;
  --van-field-input-text-color: #1e293b;
  --van-cell-group-inset-border-radius: 24rpx;
  --van-tabbar-item-active-color: #6366f1;
  --van-dialog-radius: 24rpx;
  --van-tag-primary-color: #6366f1;
  --van-tabs-bottom-bar-color: #6366f1;
  --van-search-content-background: #f1f5f9;

  background-color: var(--brand-bg);
  color: var(--brand-text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* 原生 button 兜底重置（去掉微信默认边框/内边距/背景） */
button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: inherit;
  font-size: inherit;
}
button::after {
  border: none;
}

/* ========== 通用布局 ========== */
.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--brand-card);
  border-radius: var(--brand-radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 41, 59, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 24rpx;
  color: var(--brand-muted-text);
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 8rpx 0 20rpx;
}

/* 统计卡 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  min-width: calc(50% - 8rpx);
  background: var(--brand-card);
  border-radius: var(--brand-radius-lg);
  padding: 24rpx;
  text-align: center;
  border: 2rpx solid var(--brand-border);
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand-primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--brand-muted-text);
  margin-top: 8rpx;
}

/* 评分圆 */
.score-circle {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--brand-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand-primary);
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--brand-border);
}

.list-item:last-child {
  border-bottom: none;
}

/* 空态 / 加载 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: var(--brand-muted-text);
}

.loading {
  text-align: center;
  padding: 80rpx 0;
  color: var(--brand-muted-text);
}

/* 标签兜底 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  background: var(--brand-muted);
  color: var(--brand-muted-text);
}

/* 聊天气泡（practice-session） */
.msg-row {
  display: flex;
  margin-bottom: 20rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-bubble {
  max-width: 76%;
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  word-break: break-all;
}

.msg-bubble.user {
  background: var(--brand-primary);
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
}

.msg-bubble.ai {
  background: var(--brand-card);
  border: 2rpx solid var(--brand-border);
  color: var(--brand-text);
  border-bottom-left-radius: 8rpx;
}

/* AI Markdown 块渲染（coach / prep / report） */
.md-h1 {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin: 12rpx 0 8rpx;
}

.md-h2 {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin: 10rpx 0 6rpx;
}

.md-h3 {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin: 8rpx 0 4rpx;
}

.md-li {
  display: block;
  font-size: 26rpx;
}

.md-p {
  display: block;
  font-size: 26rpx;
}

/* 品牌渐变横幅（tab 页页头） */
.banner {
  background: linear-gradient(135deg, #6366f1 0%, #818cf8 60%, #a5b4fc 100%);
  border-radius: var(--brand-radius-lg);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.banner-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.banner-btn {
  background: #ffffff;
  border-radius: 999rpx;
  height: 64rpx;
  padding: 0 28rpx;
}

.banner-btn .van-button__text {
  color: #6366f1;
  font-weight: 600;
  font-size: 26rpx;
}

/* 分隔留白工具 */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
