<view class="page">
  <view class="banner">
    <view>
      <text class="banner-title">求职进度</text>
      <text class="banner-subtitle">多公司在面，AI 军师帮你推进</text>
    </view>
    <van-button custom-class="banner-btn" round bind:click="openCreate">+ 新建</van-button>
  </view>

  <block wx:if="{{ loading }}">
    <view class="loading">
      <van-loading color="#6366f1" size="24px">加载中...</van-loading>
    </view>
  </block>

  <block wx:elif="{{ applications.length === 0 }}">
    <van-empty description="还没有求职进度，点击右上角新建" />
  </block>

  <block wx:else>
    <view class="app-card" wx:for="{{ applications }}" wx:key="id">
      <view class="app-header">
        <view class="app-title-row">
          <text class="app-company">{{ item.company }}</text>
          <van-tag type="{{ item.statusType }}">{{ item.statusLabel }}</van-tag>
        </view>
        <text class="app-position">{{ item.position }}</text>
        <view class="app-meta">
          <text>{{ item.roundLabel }}</text>
          <text> · {{ item.appliedAtText }}</text>
        </view>
      </view>

      <view class="app-actions">
        <view class="picker-cell">
          <text class="picker-label">状态</text>
          <picker
            mode="selector"
            range="{{ statusOptions }}"
            range-key="label"
            value="{{ item.statusIndex }}"
            data-id="{{ item.id }}"
            bindchange="changeStatus"
          >
            <view class="picker-value">{{ item.statusLabel }}</view>
          </picker>
        </view>
        <view class="picker-cell">
          <text class="picker-label">轮次</text>
          <picker
            mode="selector"
            range="{{ roundOptions }}"
            range-key="label"
            value="{{ item.roundIndex }}"
            data-id="{{ item.id }}"
            bindchange="changeRound"
          >
            <view class="picker-value">{{ item.roundLabel }}</view>
          </picker>
        </view>
        <van-button
          size="small"
          plain
          type="primary"
          data-id="{{ item.id }}"
          loading="{{ generatingId === item.id }}"
          bind:click="generateStrategy"
        >AI 策略</van-button>
        <van-button size="small" plain type="danger" data-id="{{ item.id }}" bind:click="deleteApplication">删除</van-button>
      </view>

      <view class="strategy-area" wx:if="{{ expandedId === item.id }}">
        <block wx:if="{{ generatingId === item.id }}">
          <view class="loading">
            <van-loading color="#6366f1" size="24px">AI 生成中...</van-loading>
          </view>
        </block>
        <block wx:else>
          <view class="strategy-header">
            <text class="strategy-title">🎯 AI 推进策略</text>
            <text class="strategy-collapse" data-id="{{ item.id }}" bindtap="toggleExpand">收起</text>
          </view>
          <view wx:if="{{ item.strategyBlocks.length === 0 }}" class="strategy-empty">暂无策略内容</view>
          <view wx:for="{{ item.strategyBlocks }}" wx:for-item="blk" wx:for-index="bi" wx:key="key">
            <text wx:if="{{ blk.type === 'h1' }}" class="md-h1">{{ blk.text }}</text>
            <text wx:elif="{{ blk.type === 'h2' }}" class="md-h2">{{ blk.text }}</text>
            <text wx:elif="{{ blk.type === 'h3' }}" class="md-h3">{{ blk.text }}</text>
            <text wx:elif="{{ blk.type === 'li' }}" class="md-li">• {{ blk.text }}</text>
            <text wx:else class="md-p">{{ blk.text }}</text>
          </view>
        </block>
      </view>
    </view>
  </block>

  <!-- 新建弹窗 -->
  <van-popup show="{{ showCreate }}" position="bottom" custom-class="create-popup" bind:close="closeCreate">
    <view class="create-wrap">
      <text class="create-title">新建求职进度</text>
      <van-field label="公司" value="{{ createCompany }}" placeholder="例：字节跳动" bind:input="onCreateCompanyInput" />
      <van-field label="岗位" value="{{ createPosition }}" placeholder="例：后端开发" bind:input="onCreatePositionInput" />
      <view class="create-picker-row">
        <text class="picker-label">状态</text>
        <picker mode="selector" range="{{ statusOptions }}" range-key="label" bindchange="onCreateStatus">
          <view class="picker-value">{{ createStatusLabel }}</view>
        </picker>
      </view>
      <view class="create-picker-row">
        <text class="picker-label">轮次</text>
        <picker mode="selector" range="{{ roundOptions }}" range-key="label" bindchange="onCreateRound">
          <view class="picker-value">{{ createRoundLabel }}</view>
        </picker>
      </view>
      <van-button type="primary" round block loading="{{ saving }}" bind:click="submitCreate" class="mt-24">保存</van-button>
    </view>
  </van-popup>
</view>
