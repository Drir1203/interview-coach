/* 面试日历页 */
.cal-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.cal-nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--brand-primary);
  background: var(--brand-muted);
  border-radius: 16rpx;
}

.cal-month {
  font-size: 32rpx;
  font-weight: 700;
}

.cal-weekdays {
  display: flex;
  margin-bottom: 8rpx;
}

.cal-weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--brand-muted-text);
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.2857%;
  display: flex;
  justify-content: center;
  margin-bottom: 8rpx;
}

.cal-day {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cal-day.today {
  background: var(--brand-primary-light);
}

.cal-day.today .cal-day-num {
  color: var(--brand-primary);
  font-weight: 700;
}

.cal-day.selected {
  background: var(--brand-primary);
}

.cal-day.selected .cal-day-num {
  color: #ffffff;
  font-weight: 700;
}

.cal-day-num {
  font-size: 28rpx;
}

.cal-dot {
  font-size: 18rpx;
  color: var(--brand-primary);
  font-weight: 700;
  line-height: 1;
  margin-top: 2rpx;
}

.cal-day.selected .cal-dot {
  color: #ffffff;
}

.cal-cell-card {
  margin-bottom: 16rpx;
  border-radius: var(--brand-radius-md);
  overflow: hidden;
}
