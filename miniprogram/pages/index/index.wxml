<view class="page">
  <!-- Hero 品牌区 -->
  <view class="hero">
    <view class="hero-top">
      <text class="hero-greeting">你好，{{ userName || '面试官' }} 👋</text>
      <text wx:if="{{ !loggedIn }}" class="hero-login" bindtap="goLogin">登录</text>
    </view>
    <text class="hero-subtitle">AI 帮你复盘每一次面试，稳步提升通过率</text>
    <van-button custom-class="hero-btn" round bind:click="goNew">+ 记录一场面试</van-button>
  </view>

  <block wx:if="{{ loading }}">
    <view class="loading">
      <van-loading color="#6366f1" size="24px">加载中...</van-loading>
    </view>
  </block>

  <block wx:elif="{{ interviews.length === 0 }}">
    <van-empty description="还没有面试记录" />
    <view class="empty-action">
      <van-button type="primary" round bind:click="goNew">记录第一场面试</van-button>
    </view>
  </block>

  <block wx:else>
    <!-- 统计 -->
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-value">{{ stats.total }}</text>
        <text class="stat-label">总面试</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{ stats.reviewed }}</text>
        <text class="stat-label">已复盘</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{ passRateDisplay }}%</text>
        <text class="stat-label">通过率</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{ stats.avgScore ? stats.avgScore.toFixed(1) : '-' }}</text>
        <text class="stat-label">平均分</text>
      </view>
    </view>

    <!-- AI 智能入口 -->
    <text class="section-title">AI 智能</text>
    <view class="feature-grid">
      <view class="feature-card" bindtap="goCoach"><text class="feature-emoji">🤖</text><text class="feature-name">AI 教练</text></view>
      <view class="feature-card" bindtap="goPrep"><text class="feature-emoji">🎯</text><text class="feature-name">面试押题</text></view>
      <view class="feature-card" bindtap="goReport"><text class="feature-emoji">📈</text><text class="feature-name">成长报告</text></view>
      <view class="feature-card feature-disabled"><text class="feature-emoji">📊</text><text class="feature-name">深入分析</text><text class="feature-soon">即将上线</text></view>
    </view>

    <!-- 近期面试 -->
    <text class="section-title">近期面试</text>

    <van-cell
      wx:for="{{ interviews }}"
      wx:key="id"
      border="{{ false }}"
      custom-class="cell-card"
      title="{{ item.company.name }} · {{ item.position }}"
      label="{{ item.roundLabel }} · {{ item.dateText }} · {{ item._count.questions }} 题"
      value="{{ item.overallScore ? item.overallScore.toFixed(1) : '' }}"
      is-link
      data-id="{{ item.id }}"
      bind:click="goDetail"
    />
  </block>
</view>
