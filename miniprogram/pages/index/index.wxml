<view class="container">
  <!-- 头部 -->
  <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
    <view>
      <text style="font-size:20px;font-weight:700;">面试总览</text>
    </view>
    <button class="btn btn-primary btn-small" bindtap="goNew">+ 记录面试</button>
  </view>

  <block wx:if="{{ loading }}">
    <view class="loading">加载中...</view>
  </block>

  <block wx:elif="{{ interviews.length === 0 }}">
    <view class="empty-state">
      <text style="display:block;font-size:40px;margin-bottom:12px;">📋</text>
      <text>还没有面试记录</text>
      <button class="btn btn-primary" style="margin-top:16px;width:auto;" bindtap="goNew">记录第一场面试</button>
    </view>
  </block>

  <block wx:else>
    <!-- 统计 -->
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-value">{{ stats.total }}</text>
        <text class="stat-label">总面试</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{ stats.reviewed }}</text>
        <text class="stat-label">已复盘</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{ Math.round(stats.passRate * 100) }}%</text>
        <text class="stat-label">通过率</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{ stats.avgScore ? stats.avgScore.toFixed(1) : '-' }}</text>
        <text class="stat-label">平均分</text>
      </view>
    </view>

    <!-- 近期面试 -->
    <text style="font-size:16px;font-weight:600;margin-bottom:12px;display:block;">近期面试</text>

    <view wx:for="{{ interviews }}" wx:key="id" class="card" data-id="{{ item.id }}" bindtap="goDetail" style="padding:12px 16px;">
      <view style="display:flex;justify-content:space-between;align-items:center;">
        <view>
          <text style="font-weight:600;">{{ item.company.name }}</text>
          <text style="color:var(--muted-foreground);margin-left:8px;">{{ item.position }}</text>
        </view>
        <view wx:if="{{ item.overallScore }}" style="font-weight:700;color:var(--primary);">
          {{ item.overallScore.toFixed(1) }}
        </view>
      </view>
      <view style="font-size:12px;color:var(--muted-foreground);margin-top:4px;">
        <text>{{ util.ROUND_LABELS[item.roundType] || item.roundType }}</text>
        <text> · {{ util.formatDate(item.date) }}</text>
        <text> · {{ item._count.questions }} 题</text>
      </view>
    </view>
  </block>
</view>
