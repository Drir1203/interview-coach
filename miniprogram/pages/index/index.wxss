/* 总览页 */
/* Hero 品牌区 */
.hero {
  background: linear-gradient(135deg, #6366f1 0%, #818cf8 55%, #a5b4fc 100%);
  border-radius: var(--brand-radius-lg);
  padding: 48rpx 32rpx 40rpx;
  margin-bottom: 24rpx;
}

.hero-greeting {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-login {
  font-size: 26rpx;
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  padding: 8rpx 28rpx;
}

.hero-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 8rpx;
  margin-bottom: 36rpx;
}

/* 主 CTA：白底靛蓝字，在渐变上最醒目 */
.hero-btn {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  border-radius: 999rpx;
}

.hero-btn .van-button__text {
  color: #6366f1;
  font-weight: 600;
  font-size: 30rpx;
}

.empty-action {
  margin-top: 24rpx;
  text-align: center;
}

.cell-card {
  margin-bottom: 16rpx;
  border-radius: var(--brand-radius-md);
  overflow: hidden;
}
