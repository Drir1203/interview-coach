<view class="container">
  <block wx:if="{{ loading }}">
    <view class="loading">加载中...</view>
  </block>

  <block wx:elif="{{ !interview }}">
    <view class="empty-state">面试记录不存在</view>
  </block>

  <block wx:else>
    <!-- 头部 -->
    <view class="card" style="padding:16px;">
      <view style="display:flex;justify-content:space-between;align-items:start;">
        <view>
          <text style="font-size:18px;font-weight:700;">{{ interview.company.name }}</text>
          <view style="font-size:13px;color:var(--muted-foreground);margin-top:4px;">
            <text>{{ interview.position }}</text>
            <text> · {{ util.ROUND_LABELS[interview.roundType] || interview.roundType }}</text>
            <text> · {{ util.formatDate(interview.date) }}</text>
          </view>
        </view>
        <text class="badge {{ interview.status === 'ai_reviewed' ? 'badge-default' : 'badge-outline' }}">
          {{ util.STATUS_LABELS[interview.status] || interview.status }}
        </text>
      </view>

      <!-- 结果标注 -->
      <view style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;">
        <text style="font-size:12px;color:var(--muted-foreground);line-height:28px;">结果：</text>
        <view wx:for="{{ ['unknown','pass','fail','waiting'] }}" wx:key="*this"
          class="badge {{ interview.result === item ? 'badge-default' : 'badge-outline' }}"
          data-value="{{ item }}" bindtap="updateResult" style="padding:4px 10px;">
          {{ item === 'unknown' ? '未知' : item === 'pass' ? '通过' : item === 'fail' ? '未通过' : '等待' }}
        </view>
      </view>

      <view style="display:flex;gap:8px;margin-top:12px;">
        <button class="btn btn-outline btn-small" bindtap="goEdit">编辑</button>
        <button class="btn btn-outline btn-small" bindtap="deleteInterview" style="color:var(--destructive);">删除</button>
      </view>
    </view>

    <!-- AI 复盘 -->
    <view class="card" style="padding:16px;">
      <block wx:if="{{ interview.status === 'ai_reviewed' }}">
        <view style="text-align:center;margin-bottom:16px;">
          <view class="score-circle" style="margin:0 auto 8px;">
            <text>{{ interview.overallScore ? interview.overallScore.toFixed(1) : '-' }}</text>
          </view>
          <text style="font-size:12px;color:var(--muted-foreground);">总体评分</text>
        </view>

        <block wx:if="{{ interview.overallFeedback }}">
          <text style="font-size:13px;color:var(--muted-foreground);display:block;margin-bottom:12px;">
            {{ interview.overallFeedback }}
          </text>
        </block>

        <block wx:if="{{ strengths.length > 0 }}">
          <text style="font-size:14px;font-weight:600;display:block;margin-bottom:8px;">✅ 优点</text>
          <view wx:for="{{ strengths }}" wx:key="*this">
            <text style="font-size:13px;color:var(--muted-foreground);">• {{ item }}</text>
          </view>
        </block>

        <block wx:if="{{ improvementAreas.length > 0 }}">
          <text style="font-size:14px;font-weight:600;display:block;margin:12px 0 8px;">🔴 改进方向</text>
          <view wx:for="{{ improvementAreas }}" wx:key="*this">
            <text style="font-size:13px;color:var(--muted-foreground);">• {{ item }}</text>
          </view>
        </block>
      </block>

      <block wx:else>
        <view style="text-align:center;">
          <text style="display:block;font-size:32px;margin-bottom:8px;">🧠</text>
          <text style="font-size:13px;color:var(--muted-foreground);display:block;margin-bottom:12px;">
            AI 将分析你的面试回答
          </text>
          <button class="btn btn-primary" bindtap="startReview" disabled="{{ reviewing }}">
            {{ reviewing ? '分析中...' : '开始 AI 复盘' }}
          </button>
        </view>
      </block>
    </view>

    <!-- 问题列表 -->
    <view class="card" style="padding:16px;">
      <text style="font-size:14px;font-weight:600;display:block;margin-bottom:12px;">
        面试问题（{{ interview.questions ? interview.questions.length : 0 }}）
      </text>

      <view wx:for="{{ interview.questions }}" wx:key="id" style="border:1rpx solid var(--border);border-radius:8px;padding:12px;margin-bottom:8px;">
        <view style="display:flex;justify-content:space-between;">
          <text style="font-size:12px;color:var(--muted-foreground);">Q{{ item.order }}</text>
          <text wx:if="{{ item.aiScore }}" style="font-weight:700;color:var(--primary);">
            {{ item.aiScore.toFixed(0) }}
          </text>
        </view>
        <text style="font-size:13px;font-weight:500;display:block;margin:4px 0;">{{ item.questionText }}</text>
        <text wx:if="{{ item.userAnswer }}" style="font-size:12px;color:var(--muted-foreground);display:block;">
          {{ item.userAnswer }}
        </text>
        <block wx:if="{{ item.aiFeedback }}">
          <view style="margin-top:8px;padding:8px;background:var(--muted);border-radius:6px;">
            <text style="font-size:12px;">{{ item.aiFeedback }}</text>
          </view>
        </block>
      </view>
    </view>

    <block wx:if="{{ interview.userNotes }}">
      <view class="card" style="padding:16px;">
        <text style="font-size:14px;font-weight:600;display:block;margin-bottom:8px;">备注</text>
        <text style="font-size:13px;color:var(--muted-foreground);">{{ interview.userNotes }}</text>
      </view>
    </block>
  </block>
</view>
