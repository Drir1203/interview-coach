/* 面试详情页 */
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.detail-company {
  font-size: 36rpx;
  font-weight: 700;
}

.detail-meta {
  font-size: 26rpx;
  color: var(--brand-muted-text);
  margin-top: 8rpx;
}

.detail-result {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.detail-result-label {
  font-size: 24rpx;
  color: var(--brand-muted-text);
}

.tag.badge-active {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  border: 2rpx solid var(--brand-primary);
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.detail-score {
  text-align: center;
  margin-bottom: 24rpx;
}

.detail-score .score-circle {
  margin: 0 auto 8rpx;
}

.detail-score-label {
  font-size: 24rpx;
  color: var(--brand-muted-text);
}

.detail-feedback {
  display: block;
  font-size: 26rpx;
  color: var(--brand-muted-text);
  margin-bottom: 20rpx;
}

.detail-subtitle {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin: 20rpx 0 8rpx;
}

.detail-item {
  font-size: 26rpx;
  color: var(--brand-muted-text);
  margin-bottom: 4rpx;
}

.detail-review-empty {
  text-align: center;
  padding: 32rpx 0;
}

.detail-review-emoji {
  display: block;
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.detail-review-hint {
  display: block;
  font-size: 26rpx;
  color: var(--brand-muted-text);
  margin-bottom: 24rpx;
}

.questions-title {
  margin-bottom: 20rpx;
}

.detail-notes {
  font-size: 26rpx;
  color: var(--brand-muted-text);
}
