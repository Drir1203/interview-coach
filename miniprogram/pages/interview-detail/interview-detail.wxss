/* 面试详情页 */
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.detail-company {
  font-size: 36rpx;
  font-weight: 700;
}

.detail-meta {
  font-size: 26rpx;
  color: var(--brand-muted-text);
  margin-top: 8rpx;
}

.detail-result {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.detail-result-label {
  font-size: 24rpx;
  color: var(--brand-muted-text);
}

.tag.badge-active {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  border: 2rpx solid var(--brand-primary);
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.detail-score {
  text-align: center;
  margin-bottom: 24rpx;
}

.detail-score .score-circle {
  margin: 0 auto 8rpx;
}

.detail-score-label {
  font-size: 24rpx;
  color: var(--brand-muted-text);
}

.detail-feedback {
  display: block;
  font-size: 26rpx;
  color: var(--brand-muted-text);
  margin-bottom: 20rpx;
}

.detail-subtitle {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin: 20rpx 0 8rpx;
}

.detail-item {
  font-size: 26rpx;
  color: var(--brand-muted-text);
  margin-bottom: 4rpx;
}

.detail-review-empty {
  text-align: center;
  padding: 32rpx 0;
}

.detail-review-emoji {
  display: block;
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.detail-review-hint {
  display: block;
  font-size: 26rpx;
  color: var(--brand-muted-text);
  margin-bottom: 24rpx;
}

.questions-title {
  margin-bottom: 20rpx;
}

.detail-notes {
  font-size: 26rpx;
  color: var(--brand-muted-text);
}

/* C1 重新分析 */
.review-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.custom-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  padding: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--brand-text);
  background: var(--brand-muted);
  border: 2rpx solid var(--brand-border);
  border-radius: var(--brand-radius-md);
  margin-bottom: 16rpx;
}

.custom-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* C3 薄弱维度 */
.weakness-row {
  margin-bottom: 16rpx;
}

.weakness-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.weakness-cat {
  font-size: 24rpx;
  color: var(--brand-text);
}

.weakness-score {
  font-size: 24rpx;
  color: var(--brand-muted-text);
}

.weakness-bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--brand-muted);
  overflow: hidden;
}

.weakness-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--brand-primary);
}

/* C4 教练下一步建议 */
.nextsteps-card {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--brand-primary-light);
  border: 2rpx solid var(--brand-primary);
  border-radius: var(--brand-radius-md);
}

.nextsteps-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-primary);
  margin-bottom: 8rpx;
}

.nextsteps-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--brand-text);
}

/* C5 + 问题卡片 */
.question-card {
  background: var(--brand-card);
  border-radius: var(--brand-radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 41, 59, 0.04);
}

.question-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.question-text {
  flex: 1;
}

.question-q {
  font-size: 22rpx;
  color: var(--brand-muted-text);
}

.question-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-text);
  margin-top: 4rpx;
}

.question-score {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.question-answer {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--brand-muted-text);
  line-height: 1.5;
}

.question-feedback {
  margin-top: 16rpx;
  padding: 20rpx;
  background: var(--brand-muted);
  border-radius: var(--brand-radius-md);
}

.question-feedback-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.question-feedback-text {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--brand-text);
}

.question-mistake {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--brand-danger);
}

.question-ops {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}

.question-op {
  font-size: 24rpx;
  color: var(--brand-primary);
}

.question-label {
  font-size: 24rpx;
  color: var(--brand-muted-text);
}

.question-improved {
  margin-top: 16rpx;
  padding: 20rpx;
  background: var(--brand-primary-light);
  border: 2rpx solid var(--brand-primary);
  border-radius: var(--brand-radius-md);
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--brand-text);
}
