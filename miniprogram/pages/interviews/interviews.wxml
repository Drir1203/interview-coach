<view class="page">
  <view class="banner">
    <view>
      <text class="banner-title">面试记录</text>
      <text class="banner-subtitle">管理你的每一次面试</text>
    </view>
    <van-button custom-class="banner-btn" round bind:click="goNew">+ 记录</van-button>
  </view>

  <!-- 搜索 -->
  <view class="search-wrap">
    <van-field
      placeholder="搜索公司或岗位..."
      value="{{ search }}"
      clearable
      left-icon="search"
      border="{{ false }}"
      bind:input="onSearchInput"
    />
  </view>

  <!-- Tab -->
  <view class="tab-bar">
    <view
      wx:for="{{ ['all','draft','recorded','ai_reviewed'] }}"
      wx:key="*this"
      class="tag tab-item {{ tab === item ? 'badge-active' : '' }}"
      data-tab="{{ item }}"
      bindtap="switchTab"
    >{{ item === 'all' ? '全部' : item === 'draft' ? '草稿' : item === 'recorded' ? '已记录' : '已复盘' }}</view>
  </view>

  <block wx:if="{{ loading }}">
    <view class="loading">加载中...</view>
  </block>

  <block wx:elif="{{ filtered.length === 0 }}">
    <van-empty description="暂无匹配的面试记录" />
  </block>

  <block wx:else>
    <van-cell
      wx:for="{{ visible }}"
      wx:key="id"
      border="{{ false }}"
      custom-class="cell-card"
      title="{{ item.company.name }} · {{ item.position }}"
      value="{{ item.overallScore ? item.overallScore.toFixed(1) : '' }}"
      is-link
      data-id="{{ item.id }}"
      bind:click="goDetail"
    >
      <view slot="extra">
        <text class="tag {{ item.status === 'ai_reviewed' ? 'badge-active' : '' }}">{{ item.statusLabel }}</text>
      </view>
    </van-cell>
    <view wx:if="{{ visible.length < filtered.length }}" class="load-more">上拉加载更多</view>
    <view wx:elif="{{ filtered.length > 20 }}" class="load-more">— 没有更多了 —</view>
  </block>
</view>
