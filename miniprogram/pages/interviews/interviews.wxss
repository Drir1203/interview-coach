/* 面试列表页 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.page-header .section-title {
  margin-bottom: 0;
}

.search-wrap {
  background: var(--brand-card);
  border-radius: var(--brand-radius-md);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.tab-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.tab-item {
  flex-shrink: 0;
}

.tag.badge-active {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  border: 2rpx solid var(--brand-primary);
}

.cell-card {
  margin-bottom: 16rpx;
  border-radius: var(--brand-radius-md);
  overflow: hidden;
}
