<view class="page login-page">
  <!-- 品牌 Hero -->
  <view class="login-hero">
    <text class="login-hero-title">i面试</text>
    <text class="login-hero-subtitle">你的 AI 面试教练</text>
  </view>

  <view class="card login-card">
    <text class="login-card-title">{{ isRegister ? '创建账号' : '登录后多设备同步' }}</text>

    <block wx:if="{{ isRegister }}">
      <van-field label="昵称" placeholder="你的昵称" value="{{ name }}" bind:input="onNameInput" />
    </block>

    <van-field label="邮箱" placeholder="your@email.com" value="{{ email }}" bind:input="onEmailInput" />
    <van-field label="密码" placeholder="至少6位" type="password" value="{{ password }}" bind:input="onPasswordInput" />

    <view wx:if="{{ error }}" class="login-error">{{ error }}</view>

    <view class="login-submit">
      <van-button type="primary" round block loading="{{ loading }}" bind:click="handleSubmit">
        {{ isRegister ? '注册' : '登录' }}
      </van-button>
    </view>

    <view class="login-switch">
      <text>{{ isRegister ? '已有账号？' : '还没有账号？' }}</text>
      <text class="login-switch-link" bindtap="switchMode">{{ isRegister ? '去登录' : '去注册' }}</text>
    </view>
  </view>
</view>
