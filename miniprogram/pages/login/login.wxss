/* 登录页 */
.login-page {
  min-height: 100vh;
}

/* 品牌 Hero：顶边出血到页面顶部 */
.login-hero {
  background: linear-gradient(135deg, #6366f1 0%, #818cf8 55%, #a5b4fc 100%);
  margin: -24rpx -24rpx 32rpx;
  padding: 112rpx 32rpx 96rpx;
  text-align: center;
  border-radius: 0 0 48rpx 48rpx;
}

.login-hero-title {
  display: block;
  font-size: 72rpx;
  font-weight: 700;
  color: #ffffff;
}

.login-hero-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 16rpx;
}

.login-card {
  padding: 32rpx 28rpx;
}

.login-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand-text);
  margin-bottom: 24rpx;
}

.login-error {
  color: var(--brand-danger);
  font-size: 24rpx;
  margin: 16rpx 0;
}

.login-submit {
  margin-top: 32rpx;
}

.login-switch {
  text-align: center;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--brand-muted-text);
}

.login-switch-link {
  color: var(--brand-primary);
  margin-left: 8rpx;
}

.login-divider {
  display: flex;
  align-items: center;
  margin: 28rpx 0 20rpx;
  color: var(--brand-muted-text);
  font-size: 24rpx;
}

.login-divider::before,
.login-divider::after {
  content: "";
  flex: 1;
  height: 2rpx;
  background: var(--brand-border);
}

.login-divider text {
  margin: 0 16rpx;
}
