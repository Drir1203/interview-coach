<view class="page">
  <view class="page-header">
    <text class="section-title">{{ isEdit ? '编辑面试' : '记录新面试' }}</text>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <text class="card-title">基本信息</text>
    <van-field label="公司名称" placeholder="例：字节跳动" value="{{ companyName }}" bind:input="onCompanyInput" />
    <van-field label="行业" placeholder="例：互联网" value="{{ companyIndustry }}" bind:input="onIndustryInput" />
    <van-field label="岗位" placeholder="例：后端开发" value="{{ position }}" bind:input="onPositionInput" />
    <van-field label="轮次" value="{{ roundTypeLabel }}" readonly is-link bind:click="openRoundPicker" />
    <van-field
      label="备注"
      type="textarea"
      autosize
      placeholder="面试整体感觉..."
      value="{{ userNotes }}"
      bind:input="onNotesInput"
    />
  </view>

  <!-- 问题列表 -->
  <view class="card">
    <view class="questions-header">
      <text class="card-title">面试问题</text>
      <van-button size="small" plain type="primary" bind:click="addQuestion">+ 添加</van-button>
    </view>

    <view wx:for="{{ questions }}" wx:key="order" class="question-block">
      <view class="question-block-header">
        <text class="question-block-label">问题 {{ item.order }}</text>
        <text class="question-remove" data-idx="{{ index }}" bindtap="removeQuestion">×</text>
      </view>
      <van-field
        label="题目"
        placeholder="面试官问了什么？"
        value="{{ item.questionText }}"
        data-idx="{{ index }}"
        bind:input="onQuestionTextInput"
      />
      <van-field
        label="回答"
        type="textarea"
        autosize
        placeholder="你是怎么回答的？（选填）"
        value="{{ item.userAnswer }}"
        data-idx="{{ index }}"
        bind:input="onAnswerInput"
      />
    </view>
  </view>

  <van-button type="primary" round block loading="{{ saving }}" bind:click="handleSave" class="save-btn">
    {{ saving ? '保存中...' : '保存面试记录' }}
  </van-button>

  <!-- 轮次选择 -->
  <van-popup show="{{ showRoundPicker }}" position="bottom" bind:close="closeRoundPicker">
    <van-picker
      columns="{{ roundColumns }}"
      show-toolbar
      title="选择轮次"
      bind:confirm="onRoundConfirm"
      bind:cancel="closeRoundPicker"
    />
  </van-popup>
</view>
