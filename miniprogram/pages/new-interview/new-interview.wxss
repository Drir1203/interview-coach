/* 新建/编辑面试页 */
.page-header {
  margin-bottom: 24rpx;
}

.page-header .section-title {
  margin-bottom: 0;
}

.questions-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.questions-header .card-title {
  margin-bottom: 0;
}

.question-block {
  border: 2rpx solid var(--brand-border);
  border-radius: var(--brand-radius-md);
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.question-block-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.question-block-label {
  font-size: 24rpx;
  color: var(--brand-muted-text);
}

.question-remove {
  font-size: 40rpx;
  color: var(--brand-danger);
  line-height: 1;
  padding: 8rpx;
}

.save-btn {
  margin-top: 32rpx;
}

/* 标签选择 */
.tag-section {
  padding: 12rpx 32rpx 20rpx;
}

.tag-section-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tag-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  font-size: 24rpx;
  color: var(--brand-text);
  background: var(--brand-muted);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.tag-chip-active {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  border: 2rpx solid var(--brand-primary);
}

.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.selected-tag {
  font-size: 24rpx;
  color: var(--brand-primary);
  background: var(--brand-primary-light);
  border: 2rpx solid var(--brand-primary);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
