<view class="session-page">
  <!-- 头部 -->
  <view class="session-header">
    <view>
      <text class="session-title">模拟面试</text>
      <text class="session-subtitle">{{ company }} · {{ position }}</text>
    </view>
    <van-button
      wx:if="{{ phase !== 'finished' }}"
      size="small"
      plain
      type="primary"
      bind:click="endSession"
      disabled="{{ recording || transcribing }}"
    >结束</van-button>
  </view>

  <block wx:if="{{ phase === 'finished' && summary }}">
    <view class="session-body">
      <view class="session-summary">
        <view class="score-circle">{{ summary.overallScore.toFixed(1) }}</view>
        <text class="session-summary-count">共 {{ summary.totalQuestions }} 题</text>
      </view>

      <block wx:if="{{ summary.strengths.length > 0 }}">
        <view class="card">
          <text class="session-summary-title">✅ 优点</text>
          <view wx:for="{{ summary.strengths }}" wx:key="*this" class="session-summary-item"><text>• {{ item }}</text></view>
        </view>
      </block>

      <block wx:if="{{ summary.improvementAreas.length > 0 }}">
        <view class="card">
          <text class="session-summary-title">💡 改进方向</text>
          <view wx:for="{{ summary.improvementAreas }}" wx:key="*this" class="session-summary-item"><text>• {{ item }}</text></view>
        </view>
      </block>

      <van-button type="primary" round block bind:click="goBack">返回</van-button>
    </view>
  </block>

  <block wx:else>
    <!-- 消息区域 -->
    <view class="session-messages">
      <view wx:for="{{ messages }}" wx:key="index" class="msg-row {{ item.role === 'user' ? 'user' : '' }}">
        <view class="msg-bubble {{ item.role === 'user' ? 'user' : 'ai' }}">{{ item.content }}</view>
        <view wx:if="{{ item.role === 'user' && item.voiceState }}" class="voice-badge">
          <text>🎙 语音状态：{{ item.voiceState.summary }}</text>
          <text>（{{ item.voiceState.score }}/10 · 语速 {{ item.voiceState.speechRate }} 字/秒 · 填充词 {{ item.voiceState.fillerCount }} 个）</text>
        </view>
      </view>
      <view wx:if="{{ phase === 'waiting' }}" class="session-thinking">思考中...</view>
    </view>

    <!-- 输入区 -->
    <view class="session-input">
      <view class="mic-btn {{ recording ? 'recording' : '' }}" bindtap="toggleRecord">
        <text>{{ recording ? '⏹' : '🎤' }}</text>
      </view>
      <van-field
        border="{{ false }}"
        type="textarea"
        autosize
        placeholder="输入你的回答..."
        value="{{ currentAnswer }}"
        bind:input="onAnswerInput"
        class="session-input-field"
      />
      <van-button
        type="primary"
        size="small"
        disabled="{{ !currentAnswer.trim() || phase === 'waiting' || recording || transcribing }}"
        bind:click="handleSend"
      >发送</van-button>
    </view>
    <view wx:if="{{ recording }}" class="record-tip">🎙 录音中...点击停止（请对着话筒回答）</view>
    <view wx:if="{{ transcribing }}" class="record-tip">⏳ 语音转写中...</view>
  </block>
</view>
