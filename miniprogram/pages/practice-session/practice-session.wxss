/* 模拟面试会话页 */
.session-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--brand-bg);
}

.session-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: var(--brand-card);
  border-bottom: 2rpx solid var(--brand-border);
}

.session-title {
  font-weight: 600;
  font-size: 30rpx;
}

.session-subtitle {
  display: block;
  font-size: 22rpx;
  color: var(--brand-muted-text);
  margin-top: 4rpx;
}

.session-body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
  box-sizing: border-box;
}

.session-summary {
  text-align: center;
  margin-bottom: 24rpx;
}

.session-summary .score-circle {
  margin: 0 auto 12rpx;
}

.session-summary-count {
  font-size: 26rpx;
  color: var(--brand-muted-text);
}

.session-summary-title {
  display: block;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.session-summary-item {
  font-size: 24rpx;
  color: var(--brand-muted-text);
  margin-bottom: 4rpx;
}

.session-messages {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
  box-sizing: border-box;
}

.session-thinking {
  text-align: center;
  padding: 24rpx;
  color: var(--brand-muted-text);
  font-size: 26rpx;
}

.session-input {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--brand-card);
  border-top: 2rpx solid var(--brand-border);
}

.session-input-field {
  flex: 1;
}
