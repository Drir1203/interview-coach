<view class="page">
  <view class="banner">
    <view>
      <text class="banner-title">模拟面试</text>
      <text class="banner-subtitle">AI 面试官模拟真实面试，结束后生成报告</text>
    </view>
  </view>

  <view class="stats-grid practice-features">
    <view class="stat-card">
      <text class="practice-feature-emoji">🧠</text>
      <text class="stat-label">AI 面试官</text>
    </view>
    <view class="stat-card">
      <text class="practice-feature-emoji">🎯</text>
      <text class="stat-label">薄弱项练习</text>
    </view>
    <view class="stat-card">
      <text class="practice-feature-emoji">📊</text>
      <text class="stat-label">面后报告</text>
    </view>
  </view>

  <view class="card">
    <text class="card-title">配置模拟面试</text>
    <suggest-field label="目标公司" placeholder="例：字节跳动" value="{{ company }}" suggestions="{{ companySuggestions }}" bind:input="onCompanyInput" />
    <suggest-field label="岗位" placeholder="例：后端开发" value="{{ position }}" suggestions="{{ positionSuggestions }}" bind:input="onPositionInput" />
    <van-field label="模拟轮次" value="{{ roundTypeLabel }}" readonly is-link bind:click="openRoundPicker" />
    <view class="grill-toggle">
      <view class="grill-info">
        <text class="grill-title">简历深挖模式</text>
        <text class="grill-desc">{{ hasResume ? 'AI 盯着你简历的漏洞和矛盾点拷打' : '需先在「我的」页填写简历才能使用' }}</text>
      </view>
      <switch checked="{{ grillMode }}" disabled="{{ !hasResume }}" bindchange="onGrillToggle" color="#6366f1" />
    </view>
    <van-button type="primary" round block loading="{{ starting }}" bind:click="startMock" class="start-btn">
      {{ starting ? '准备中...' : '开始模拟面试' }}
    </van-button>
  </view>

  <van-popup show="{{ showRoundPicker }}" position="bottom" bind:close="closeRoundPicker">
    <van-picker
      columns="{{ roundColumns }}"
      show-toolbar
      title="选择轮次"
      bind:confirm="onRoundConfirm"
      bind:cancel="closeRoundPicker"
    />
  </van-popup>
</view>
