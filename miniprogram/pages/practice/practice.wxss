/* 模拟面试配置页 */
.practice-header {
  margin-bottom: 24rpx;
}

.practice-header .section-title {
  margin-bottom: 4rpx;
}

.practice-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--brand-muted-text);
  margin-top: 4rpx;
}

.practice-features {
  margin-bottom: 20rpx;
}

.practice-feature-emoji {
  display: block;
  font-size: 48rpx;
}

.start-btn {
  margin-top: 24rpx;
}

/* 简历深挖开关 */
.grill-toggle {
  display: flex;
  align-items: center;
  background: var(--brand-card);
  border: 2rpx solid var(--brand-border);
  border-radius: var(--brand-radius-md);
  padding: 20rpx 24rpx;
  margin-top: 20rpx;
}

.grill-info {
  flex: 1;
  margin-right: 16rpx;
}

.grill-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-text);
}

.grill-desc {
  display: block;
  font-size: 22rpx;
  color: var(--brand-muted-text);
  margin-top: 4rpx;
}
