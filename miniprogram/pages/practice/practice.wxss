/* 模拟面试配置页 */
.practice-header {
  margin-bottom: 24rpx;
}

.practice-header .section-title {
  margin-bottom: 4rpx;
}

.practice-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--brand-muted-text);
  margin-top: 4rpx;
}

.practice-features {
  margin-bottom: 20rpx;
}

.practice-feature-emoji {
  display: block;
  font-size: 48rpx;
}

.start-btn {
  margin-top: 24rpx;
}

/* 简历深挖开关 */
.grill-toggle {
  display: flex;
  align-items: center;
  background: var(--brand-card);
  border: 2rpx solid var(--brand-border);
  border-radius: var(--brand-radius-md);
  padding: 20rpx 24rpx;
  margin-top: 20rpx;
}

.grill-info {
  flex: 1;
  margin-right: 16rpx;
}

.grill-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-text);
}

.grill-desc {
  display: block;
  font-size: 22rpx;
  color: var(--brand-muted-text);
  margin-top: 4rpx;
}

/* 我的题库：选择题库区 */
.bank-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bank-manage {
  font-size: 24rpx;
  color: var(--brand-primary);
}

.bank-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid var(--brand-border);
  border-radius: var(--brand-radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.bank-option-active {
  border-color: var(--brand-primary);
  background: var(--brand-primary-light);
}

.bank-option-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.bank-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bank-count {
  display: block;
  font-size: 22rpx;
  color: var(--brand-muted-text);
  margin-top: 4rpx;
}

.bank-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid var(--brand-border);
  box-sizing: border-box;
  flex-shrink: 0;
}

.bank-radio-on {
  border: 10rpx solid var(--brand-primary);
}

.bank-hint {
  display: block;
  font-size: 22rpx;
  color: var(--brand-muted-text);
  margin-top: 4rpx;
}

.bank-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0 8rpx;
}

.bank-empty-text {
  font-size: 24rpx;
  color: var(--brand-muted-text);
}
