<view class="page">
  <!-- 用户区：登录→渐变资料卡，未登录→登录引导 -->
  <block wx:if="{{ user }}">
    <view class="profile-banner">
      <view class="profile-avatar">{{ avatarLetter }}</view>
      <view class="profile-info">
        <text class="profile-name">{{ user.name || user.email }}</text>
        <text class="profile-email">{{ user.email }}</text>
      </view>
      <text class="profile-logged">已登录</text>
    </view>
  </block>

  <block wx:else>
    <view class="profile-banner">
      <view class="profile-avatar">👤</view>
      <view class="profile-info">
        <text class="profile-name">未登录</text>
        <text class="profile-email">登录后数据多设备同步</text>
      </view>
      <van-button custom-class="profile-login-btn" round size="small" bind:click="goLogin">登录</van-button>
    </view>
  </block>

  <!-- 会员卡：展示会员档位 / 语音月度用量 / 语音点数，升级与加购跳转定价页 -->
  <view class="card mt-24 member-card">
    <text class="card-title">会员 / 我的点数</text>
    <block wx:if="{{ sub }}">
      <view class="member-row">
        <text class="member-label">当前档位</text>
        <view class="member-badges">
          <text class="member-tier {{ sub.isPro ? 'is-pro' : '' }}">{{ sub.tierLabel }}</text>
          <text wx:if="{{ sub.isTrial }}" class="tag trial-tag">试用中</text>
        </view>
      </view>
      <view class="member-row">
        <text class="member-label">有效期</text>
        <text class="member-value">{{ sub.proExpires }}</text>
      </view>
      <view class="member-row">
        <text class="member-label">面试记录</text>
        <text class="member-value">{{ sub.recordText }}</text>
      </view>
      <view class="member-row">
        <text class="member-label">AI 语音 · 本月</text>
        <text class="member-value">{{ sub.voiceUsageText }}</text>
      </view>
      <view class="member-row">
        <text class="member-label">语音点数</text>
        <text class="member-value strong">{{ sub.voiceCreditsText }}</text>
      </view>
      <view class="member-actions" wx:if="{{ sub.loggedIn }}">
        <van-button size="small" round plain type="primary" bind:click="goPricing">加购语音点数</van-button>
        <van-button size="small" round type="{{ sub.isPro ? 'default' : 'primary' }}" bind:click="goPricing">{{ sub.isPro ? '管理会员' : '升级 Pro' }}</van-button>
      </view>
      <van-button wx:else round block type="primary" size="small" bind:click="goLogin">登录 / 查看会员</van-button>
    </block>
    <view wx:elif="{{ subLoading }}" class="member-loading">加载中…</view>
  </view>

  <!-- 功能菜单 -->
  <van-cell-group inset class="mt-24">
    <van-cell title="修改昵称" value="{{ user.name || '' }}" is-link bind:click="openNameEdit" />
    <van-cell title="修改密码" is-link bind:click="openPwdEdit" />
    <van-cell title="服务状态" label="AI 复盘已上线 · 录音转写已上线 · 数据云端存储" />
    <van-cell title="关于 AI 面师" label="v1.0 · 你的 AI 面试教练" />
  </van-cell-group>

  <!-- 简历 -->
  <view class="card mt-24">
    <text class="card-title">我的简历</text>
    <text class="card-desc">粘贴简历文字，AI 复盘/押题时作为候选人背景参考</text>
    <van-field
      type="textarea"
      autosize
      maxlength="20000"
      placeholder="粘贴你的简历文本..."
      value="{{ resumeText }}"
      bind:input="onResumeInput"
    />
    <van-button type="primary" round size="small" loading="{{ resumeSaving }}" bind:click="saveResume" class="mt-16">
      保存简历
    </van-button>
  </view>

  <van-button wx:if="{{ user }}" round block type="danger" bind:click="logout" class="logout-btn">退出登录</van-button>

  <!-- 修改昵称弹窗 -->
  <van-popup show="{{ showNameEdit }}" position="bottom" bind:close="closeNameEdit">
    <view class="name-edit">
      <text class="name-edit-title">修改昵称</text>
      <van-field placeholder="输入你的昵称" value="{{ editName }}" bind:input="onNameEditInput" />
      <van-button type="primary" round block bind:click="saveName" class="mt-24">保存</van-button>
    </view>
  </van-popup>

  <!-- 修改密码弹窗 -->
  <van-popup show="{{ showPwdEdit }}" position="bottom" bind:close="closePwdEdit">
    <view class="pwd-edit">
      <text class="pwd-edit-title">修改密码</text>
      <text wx:if="{{ user && !user.email }}" class="pwd-edit-hint">微信登录用户可直接设置密码</text>
      <van-field
        type="password"
        placeholder="当前密码（留空则跳过）"
        value="{{ oldPwd }}"
        data-field="oldPwd"
        bind:input="onPwdInput"
      />
      <van-field
        type="password"
        placeholder="新密码（至少 6 位）"
        value="{{ newPwd }}"
        data-field="newPwd"
        bind:input="onPwdInput"
      />
      <van-field
        type="password"
        placeholder="确认新密码"
        value="{{ confirmPwd }}"
        data-field="confirmPwd"
        bind:input="onPwdInput"
      />
      <van-button type="primary" round block loading="{{ pwdSaving }}" bind:click="savePwd" class="mt-24">保存</van-button>
    </view>
  </van-popup>
</view>
