/* 录音转写页 */
.record-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.record-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.record-btn.recording {
  background: var(--brand-danger);
  animation: record-pulse 1.2s infinite;
}

@keyframes record-pulse {
  0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
  70% { box-shadow: 0 0 0 24rpx rgba(239, 68, 68, 0); }
  100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
}

.record-icon {
  font-size: 56rpx;
}

.record-text {
  font-size: 26rpx;
  margin-top: 8rpx;
}

.record-tip {
  display: block;
  font-size: 22rpx;
  color: var(--brand-muted-text);
  margin-top: 24rpx;
}

.transcript-text {
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
