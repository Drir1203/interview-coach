generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────── Auth Models (NextAuth.js) ──────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ────────── 用户 ──────────
model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?   // 密码登录用
  wechatOpenid   String?   @unique // 微信小程序 openid，微信一键登录用
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // 用户级简历（AI 复盘时作为分析背景）
  resumeText       String?   @db.Text // 解析后的简历纯文本
  resumeFileName   String?            // 原始 PDF 文件名，仅用于前端展示
  resumeUpdatedAt  DateTime?          // 简历最后更新时间（手动维护）

  // 会员（付费墙）：proExpiresAt 为唯一 pro 判定源（now < proExpiresAt → pro）
  proExpiresAt   DateTime?  // 会员/试用到期时间
  trialClaimedAt DateTime?  // 试用领取时间（防重复，每账号一次）

  accounts           Account[]
  sessions           Session[]
  interviews         Interview[]
  skillProfiles      UserSkillProfile[]
  tags               Tag[]
  applications       JobApplication[]
  coachConversations CoachConversation[]
  subscriptionOrders SubscriptionOrder[]
}

// ────────── 订阅订单（付费墙，v1 仅 Mock 渠道） ──────────
model SubscriptionOrder {
  id              String    @id @default(cuid())
  userId          String
  plan            String    // month | quarter | year
  amount          Int       // 金额（分：¥29 → 2900；试用 0）
  status          String    // pending | paid | refunded
  source          String    // trial | mock（v2: wechat | alipay）
  providerOrderId String?   // 第三方渠道单号（渠道回填，mock 为 null）
  paidAt          DateTime? // 支付成功时间
  expiresAt       DateTime? // 本单生效后的会员到期时间（续费叠加用）
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ────────── 公司 ──────────
model Company {
  id       String @id @default(cuid())
  name     String
  industry String?

  interviews Interview[]
}

// ────────── 面试场次 ──────────
model Interview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  date      DateTime @default(now())
  status    String   @default("draft")

  userId    String
  companyId String
  position  String
  roundType String
  result    String? // pass | fail | waiting | unknown

  userNotes String?

  overallScore     Float?
  overallFeedback  String?
  strengths        String?
  improvementAreas String?
  weaknessAreas    String?

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company @relation(fields: [companyId], references: [id])
  questions  InterviewQuestion[]
  recordings AudioRecording[]
  tags       InterviewTag[]

  @@index([userId])
  @@index([companyId])
  @@index([date])
}

// ────────── 面试问题 ──────────
model InterviewQuestion {
  id           String @id @default(cuid())
  interviewId  String
  order        Int
  questionText String
  userAnswer   String?

  userScore Int?

  aiScore          Float?
  aiFeedback       String?
  aiImprovedAnswer String?
  aiCategory       String?
  aiKeyMistake     String?

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

// ────────── 录音 ──────────
model AudioRecording {
  id           String   @id @default(cuid())
  interviewId  String
  audioData    String?
  audioUrl     String?
  duration     Int
  transcript   String?
  status       String   @default("recorded")
  createdAt    DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

// ────────── 标签 ──────────
model Tag {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String @default("#6366f1")

  user       User          @relation(fields: [userId], references: [id])
  interviews InterviewTag[]

  @@unique([userId, name])
}

model InterviewTag {
  interviewId String
  tagId       String

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([interviewId, tagId])
}

// ────────── 用户技能画像 ──────────
model UserSkillProfile {
  id             String   @id @default(cuid())
  userId         String
  category       String
  averageScore   Float    @default(0)
  interviewCount Int      @default(0)
  lastScore      Float?
  lastDate       DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, category])
}

// ────────── 求职进度追踪 ──────────
model JobApplication {
  id           String   @id @default(cuid())
  userId       String
  company      String
  position     String
  status       String   @default("applied") // applied | interviewing | offer | rejected | closed
  currentRound String   @default("first")   // first | second | third | final | hr | written
  appliedAt    DateTime @default(now())
  notes        String?
  nextStep     String?  // AI 建议的下一步行动
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ────────── 面经众包（匿名贡献真实面试题） ──────────
model InterviewExperience {
  id                String   @id @default(cuid())
  userId            String?   // 贡献者（匿名化存储，供"我的贡献/撤回"使用）
  sourceInterviewId String?   // 来源面试记录（可选，便于追溯）
  company           String
  position          String
  round             String   @default("other") // first | second | third | final | hr | written | other
  question          String   // 真实被问到的问题（脱敏）
  answer            String?  // 候选人当时的回答（可选）
  createdAt         DateTime @default(now())

  @@index([company, position])
  @@index([createdAt])
  @@index([userId])
}

// ────────── AI 教练对话持久化 ──────────
model CoachConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId, updatedAt])
}

model CoachMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ────────── 管理后台账号（独立于用户体系） ──────────
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
